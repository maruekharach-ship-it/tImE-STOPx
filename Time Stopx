-- ระบบหยุดเวลา (Time Stop Logic)
---------------------------------------------------------
local isTimeStopped = false
local LocalPlayer = game.Players.LocalPlayer

local function toggleTimeStop()
    isTimeStopped = not isTimeStopped
    
    if isTimeStopped then
        -- เปลี่ยนสถานะปุ่มเป็น ON (สีเขียว)
        ToggleButton.Text = "หยุดเวลา : ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        -- ตรึงตำแหน่ง Player/NPC อื่นๆ ทั้งหมดใน Server Client Side
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and obj.Parent ~= LocalPlayer.Character then
                local root = obj.Parent:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Anchored = true
                end
            end
        end
    else
        -- เปลี่ยนสถานะปุ่มเป็น OFF (สีแดง)
        ToggleButton.Text = "หยุดเวลา : OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        
        -- ปลดการตรึงตำแหน่งให้กลับมาขยับได้ปกติ
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and obj.Parent ~= LocalPlayer.Character then
                local root = obj.Parent:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Anchored = false
                end
            end
        end
    end
end

-- เมื่อคลิกปุ่มให้ทำงานฟังก์ชัน toggleTimeStop
ToggleButton.MouseButton1Click:Connect(toggleTimeStop)
